PORT=4317
CODESENTINEL_ROOT=.
CODESENTINEL_API_TOKEN=
CODESENTINEL_DEFAULT_TEAM_ID=
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_DB=codesentinel

# Optional: enables the real Anthropic-backed AI provider when a scan is
# run with --ai-provider anthropic. Never selected by default - scans
# without that flag keep using the local deterministic AI provider.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
